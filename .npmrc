# npm configuration
# Note: npm warnings about --production flag may still appear from
# Vercel/Railway's internal npm commands which we cannot control.
# Our explicit install commands use modern syntax (--omit=dev instead of --production).
# 
# To avoid warnings locally:
# - Don't set NODE_ENV=production when running npm install/ci for development
# - Use explicit flags: npm ci (for all deps) or npm ci --omit=dev (production only)
# - Warnings from deployment platforms are safe to ignore as they handle it correctly
legacy-peer-deps=false

